DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require
SESSION_SECRET=change-me-in-production-32-chars-min
SECRET_ENCRYPTION_KEY=change-me-in-production-32-chars-min

# Agent AI runtime — provider/model/prompt/enabledTools come from the DB
# (agent_config row). Only credentials + endpoint live in env; nothing is
# hardcoded. Provider-specific overrides use AGENT_AI_<PROVIDER>_API_KEY /
# AGENT_AI_<PROVIDER>_BASE_URL / AGENT_AI_<PROVIDER>_ENDPOINT_URL.
AGENT_AI_API_KEY=
AGENT_AI_BASE_URL=
AGENT_AI_ENDPOINT_URL=
AGENT_AI_ENDPOINT_PATH=/chat/completions

# WhatsApp Business import (P6, observe-only). Optional; the webhook is
# config-gated and answers 503 until both are set. Use API-key-style shared
# secrets (no OAuth): WHATSAPP_APP_SECRET signs the webhook body
# (X-Hub-Signature-256), WHATSAPP_VERIFY_TOKEN is the Meta handshake token.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
