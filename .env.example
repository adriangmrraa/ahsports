DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require
SESSION_SECRET=change-me-in-production-32-chars-min
SECRET_ENCRYPTION_KEY=change-me-in-production-32-chars-min

# Agent AI runtime — provider/model/prompt/enabledTools come from the DB
# (agent_config row). Only credentials + endpoint live in env; nothing is
# hardcoded. Provider-specific overrides use AGENT_AI_<PROVIDER>_API_KEY /
# AGENT_AI_<PROVIDER>_BASE_URL / AGENT_AI_<PROVIDER>_ENDPOINT_URL.
AGENT_AI_API_KEY=
AGENT_AI_BASE_URL=
AGENT_AI_ENDPOINT_URL=
AGENT_AI_ENDPOINT_PATH=/chat/completions

# WhatsApp Business import (P6, observe-only). Optional; the webhook is
# config-gated and answers 503 until both are set. Use API-key-style shared
# secrets (no OAuth): WHATSAPP_APP_SECRET signs the webhook body
# (X-Hub-Signature-256), WHATSAPP_VERIFY_TOKEN is the Meta handshake token.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# WhatsApp send path (G1, two-way via YCloud). Optional; the send is
# config-gated and a missing key/number turns every send into a no-op
# (error "not_configured"), so no message is ever sent without config.
# YCLOUD_BASE_URL defaults to https://api.ycloud.com.
YCLOUD_API_KEY=
WHATSAPP_PHONE_NUMBER=
YCLOUD_BASE_URL=

# Meta attribution (W6). Optional; both paths degrade gracefully when unset.
# META_PIXEL_ID is the fallback pixel id — the `meta_pixel_id` settings row
# (editable from /admin/configuracion) takes precedence when present.
# META_CAPI_TOKEN is the server-side Conversions API token (secret — env only,
# never in the DB). Without it, CAPI sends return "not_configured" no-ops.
# NEXT_PUBLIC_WHATSAPP_PHONE is the public wa.me number used to prefill the
# admin link generator (after taller_contacto_phone and WHATSAPP_PHONE_NUMBER).
META_PIXEL_ID=
META_CAPI_TOKEN=
NEXT_PUBLIC_WHATSAPP_PHONE=
